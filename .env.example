# Public game web configuration. These values are safe to expose to the browser.
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:2567
NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:3000/assets
NEXT_PUBLIC_RELEASE_CHANNEL=development

# Authoritative server configuration. Configure only in the server deployment.
PORT=2567
GAME_WEB_ORIGIN=http://localhost:3000
NINGACADEMY_MAIN_ORIGIN=http://localhost:3001
GAME_SERVER_REGION=local
GAME_SESSION_COOKIE_NAME=ningacademy_game_session

# Phase 0 staging integration. Never use production credentials for local development.
# SUPABASE_STAGING_DATABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# NINGACADEMY_INTERNAL_ORIGIN=http://localhost:3001
