# Public build-time presentation configuration.
NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:3000/assets
NEXT_PUBLIC_RELEASE_CHANNEL=development

# Server-only Next.js/Vercel Route Handler configuration.
GAME_WEB_ORIGIN=http://localhost:3000
NINGACADEMY_MAIN_ORIGIN=http://localhost:3001
# Local HTTP only. Production HTTPS must use __Host-ning_game_session.
GAME_SESSION_COOKIE_NAME=ningacademy_game_session
GAME_RULESET_VERSION=p0

# Restricted Production Supabase/pooler LOGIN. The LOGIN must only be able to
# SET ROLE games_api; never use postgres, owner, publishable, or service keys.
# GAME_DATABASE_URL=postgresql://games_api_login:...@.../postgres?sslmode=verify-full
# GAME_DATABASE_ROLE=games_api

# ICE configuration is returned only after Games-session validation. STUN is
# required in Production. TURN remains optional and can be added without a
# networking rewrite.
GAME_STUN_URLS=stun:stun.l.google.com:19302
# GAME_TURN_URLS=turns:turn.example.com:5349
# GAME_TURN_USERNAME=
# GAME_TURN_CREDENTIAL=
